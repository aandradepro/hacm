        {
            "id": "hero",
            "content": {
                "title": "Coordinating Enterprise Analytics",
                "subtitle": "An architectural perspective on semantic consistency, governance and modernization",
                "heading": "Enterprise Data Architecture",
                "brand": "~Å~",
                "tags": {
                    "componentType": "tags",

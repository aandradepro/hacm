        {
            "id": "problem",
            "content": {
                "badge": "The Challenge",
                "title": "Enterprise analytics rarely fail because of technology.",
                "subtitle": "They fail because organizations lose control over meaning.",
                "list": {
                    "componentType": "list",
                    "content": {
                        "items": [
                            "As organizations grow, analytical capabilities evolve independently.",
                            "Business units create different KPIs.",
                            "Projects implement different business rules.",
                            "Platforms evolve at different speeds.",
                            "Governance becomes fragmented.",
                            "Technology continues to scale.",
                            "Business trust does not."
                        ]
                    }
                },
                "message": {
                    "componentType": "message",
                    "content": {
                        "text": "Architecture exists to coordinate meaning before systems coordinate data."
                    }
                },
                "SAPPerspective": {
                    "componentType": "SAPPerspective",
                    "content": {
                        "items": [
                            "The same challenge appears during SAP modernization initiatives involving BW, Datasphere and Business Data Cloud, but it is fundamentally an enterprise architecture problem rather than a product problem."
                        ]
                    }
                },
                "convergence": {
                    "componentType": "convergenceDiagram",
                    "content": {
                        "center": "Enterprise Meaning",
                        "nodes": [
                            "Business Units",
                            "Analytics Teams",
                            "Regional Operations",
                            "Cloud Platforms",
                            "AI",
                            "Partners"
                        ]
                    }
                }
            }
        },
        {
            "id": "thesis",
            "content": {
                "badge": "The Architectural Thesis",
                "title": "Architectural coordination comes before platform selection.",
                "subtitle": "Every analytical architecture should answer four questions before selecting technology.",
                "list": {
                    "componentType": "list",
                    "content": {
                        "items": [
                            "Who owns business meaning?",
                            "Which analytical assets should become reusable?",
                            "Which decisions should remain centralized?",
                            {
                                "text": "Which trade-offs are intentional?",
                                "subitems": [
                                    "Consistency versus Local Autonomy",
                                    "Governance versus Agility",
                                    "Performance versus Maintainability",
                                    "Standardization versus Innovation"
                                ]
                            }
                        ]
                    }
                },
                "message": {
                    "componentType": "message",
                    "content": {
                        "text": "Good architecture makes organizational decisions explicit before technical decisions become permanent."
                    }
                },
                "SAPPerspective": {
                    "componentType": "SAPPerspective",
                    "content": {
                        "items": [
                            "Capabilities such as Business Data Cloud, Datasphere and Data Products deliver greater value when architectural decisions already exist."
                        ]
                    }
                },
                "flowVDiagram": {
                    "componentType": "flowVDiagram",
                    "content": {
                        "title": "Architectural Path",
                        "steps": [
                            "Business Strategy",
                            "Business Semantics",
                            "Governance",
                            "Reusable Analytical Assets",
                            "Technology Platform"
                        ]
                    }
                }
            }
        },
        {

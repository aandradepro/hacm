# ============================================================
# FILE: .gitignore
# PURPOSE: Files and folders to exclude from version control
# ============================================================

# Dependencies
/node_modules
/.pnp
.pnp.js
.pnp.*
.yarn/*
!.yarn/cache
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/sdks
!.yarn/versions

# Build output
/.next
/out
/build
/dist
/.vercel

# Environment variables
.env
.env.local
.env*.local
.env.development.local
.env.test.local
.env.production.local

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Editor and IDE
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store

# TypeScript
*.tsbuildinfo
next-env.d.ts

# Coverage
/coverage

# Temporary files
/tmp
*.tmp
*.temp

# OS files
Thumbs.db
Desktop.ini
.DS_Store

# Uploaded files
/uploads

# Cache
.cache
.parcel-cache

# Misc
*.pem
*.p12
*.pfx
*.crt
*.key
.env.*.local
.env.local
.env